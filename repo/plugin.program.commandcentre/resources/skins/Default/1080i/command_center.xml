<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">5001</defaultcontrol>
    <controls>
        <!-- Dimmed backdrop: the popup is an overlay, so what is behind it stays visible. -->
        <control type="image">
            <posx>0</posx><posy>0</posy><width>1920</width><height>1080</height>
            <colordiffuse>CC000000</colordiffuse>
            <texture>colors/black.png</texture>
        </control>

        <!-- Sizing: the list shows 18 whole rows of 56px (1008) with 12px above and below = 1032 tall, centred on
             the 1080 screen (24px above and below) when full. dialog.py shrinks the panel and re-centres it
             (group id 5000, background id 5003) when there are fewer rows; this XML is the full-size default. -->
        <control type="group" id="5000">
            <posx>460</posx><posy>24</posy><width>1000</width><height>1032</height>
            <control type="image" id="5003">
                <posx>0</posx><posy>0</posy><width>1000</width><height>1032</height>
                <colordiffuse>FF1c1c1c</colordiffuse><texture>colors/white.png</texture>
            </control>

            <!-- The only focusable list. Every row (section heading or item) is a real
                 list row of the same height: a <list> evaluates <itemlayout> conditions
                 once when built, not per row, so heading rows can't have their own height.
                 Which sub-controls show is switched per row with <visible> instead.
                 Headings are skipped over by dialog.py. -->
            <control type="list" id="5001">
                <posx>20</posx><posy>12</posy><width>940</width><height>1008</height>
                <onleft>5001</onleft><onright>5001</onright>
                <scrolltime>150</scrolltime><itemgap>0</itemgap>
                <orientation>vertical</orientation>
                <pagecontrol>5002</pagecontrol>

                <itemlayout width="940" height="56">
                    <control type="label">
                        <posx>76</posx><posy>0</posy><width>820</width><height>56</height>
                        <font>font32_title</font><textcolor>FFAAAAAA</textcolor>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEqual(ListItem.Property(row_type),header)</visible>
                    </control>
                    <control type="image">
                        <posx>0</posx><posy>6</posy><width>44</width><height>44</height>
                        <texture fallback="DefaultAddonProgram.png">$INFO[ListItem.Icon]</texture>
                        <visible>String.IsEqual(ListItem.Property(row_type),item)</visible>
                    </control>
                    <control type="label">
                        <posx>68</posx><posy>6</posy><width>820</width><height>44</height>
                        <font>font32</font><textcolor>FFEEEEEE</textcolor>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEqual(ListItem.Property(row_type),item)</visible>
                    </control>
                </itemlayout>

                <focusedlayout width="940" height="56">
                    <control type="image">
                        <posx>0</posx><posy>0</posy><width>940</width><height>56</height>
                        <texture colordiffuse="$INFO[Window.Property(nav_highlight_color)]">colors/white.png</texture>
                        <visible>String.IsEqual(ListItem.Property(row_type),item)</visible>
                    </control>
                    <control type="label">
                        <posx>76</posx><posy>0</posy><width>820</width><height>56</height>
                        <font>font32_title</font><textcolor>FFAAAAAA</textcolor>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEqual(ListItem.Property(row_type),header)</visible>
                    </control>
                    <control type="image">
                        <posx>0</posx><posy>6</posy><width>44</width><height>44</height>
                        <texture fallback="DefaultAddonProgram.png">$INFO[ListItem.Icon]</texture>
                        <visible>String.IsEqual(ListItem.Property(row_type),item)</visible>
                    </control>
                    <!-- Two label variants (white / black text) instead of a dynamic
                         <textcolor>, which Kodi only documents for static values: the
                         per-row <visible> switch is the proven mechanism. Black text is
                         used when the highlight colour is light. Long names scroll. -->
                    <control type="label">
                        <posx>68</posx><posy>6</posy><width>820</width><height>44</height>
                        <font>font32</font><textcolor>FFFFFFFF</textcolor>
                        <aligny>center</aligny>
                        <scroll>true</scroll>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEqual(ListItem.Property(row_type),item) + !String.IsEqual(Window.Property(nav_highlight_is_light),true)</visible>
                    </control>
                    <control type="label">
                        <posx>68</posx><posy>6</posy><width>820</width><height>44</height>
                        <font>font32</font><textcolor>FF000000</textcolor>
                        <aligny>center</aligny>
                        <scroll>true</scroll>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEqual(ListItem.Property(row_type),item) + String.IsEqual(Window.Property(nav_highlight_is_light),true)</visible>
                    </control>
                </focusedlayout>
            </control>

            <control type="scrollbar" id="5002">
                <posx>966</posx><posy>12</posy><width>14</width><height>1008</height>
                <texturesliderbackground colordiffuse="33FFFFFF">colors/white.png</texturesliderbackground>
                <texturesliderbar colordiffuse="88FFFFFF">colors/white.png</texturesliderbar>
                <texturesliderbarfocus colordiffuse="FFFFFFFF">colors/white.png</texturesliderbarfocus>
                <showonepage>false</showonepage>
                <orientation>vertical</orientation>
                <onleft>5001</onleft>
            </control>
        </control>
    </controls>
</window>
